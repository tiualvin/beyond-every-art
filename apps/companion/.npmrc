# A flat node_modules inside this directory, and nothing borrowed from above.
#
# Metro, Jest and TypeScript are all configured to resolve only from
# `./node_modules` (see metro.config.js, jest.config.js, tsconfig.json), so the
# website's React, @types/react and @types/node in the repository root can
# never stand in for a missing dependency here. pnpm's default isolated layout
# keeps transitive dependencies in `.pnpm/` and finds them by walking up the
# tree — exactly the lookup this project turns off — so this project installs
# hoisted, which Expo supports for pnpm projects.
node-linker=hoisted
