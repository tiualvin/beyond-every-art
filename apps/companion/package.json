  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "prettier": "3.9.9",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
