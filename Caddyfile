# ── How certificates are obtained ─────────────────────────────────────────────
#
# Two named strategies, chosen by CADDY_ACME rather than by editing this file on
# the server. The default is what this deployment has always done: HTTP-01,
# where Let's Encrypt reaches this machine directly on port 80. It is an empty
# snippet because that is already Caddy's own behaviour — naming it is what
# makes the other one selectable.
#
# Setting CADDY_ACME=acme-cloudflare in the production .env moves every site
# block to DNS-01, which proves ownership by writing a TXT record and therefore
# keeps working once Cloudflare terminates TLS at their edge. It needs
# CLOUDFLARE_API_TOKEN set in the same file.
#
# Order matters and the failure is silent: switch to DNS-01 and confirm a
# certificate has been obtained through it BEFORE turning the orange cloud on.
# Proxying first leaves the current certificate working and breaks its renewal,
# about thirty days before expiry, with a browser warning as the first symptom.
# Read docs/EDGE_PROTECTION.md before changing this.
(acme-default) {
}

(acme-cloudflare) {
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
}

# Public site.
{$SITE_ADDRESS:localhost} {
  import {$CADDY_ACME:acme-default}

  encode zstd gzip

  # Staff tooling is served only on the CMS hostname below, so the address
  # readers and search engines use exposes no write endpoint and no login form
  # at all. Two things follow from that:
  #
  #   - The admin panel cannot be reached here. Payload locks an account after
  #     five failed passwords, which stops guessing but means anyone who can
  #     find the login form can also lock an editor out of it on demand.
  #   - Payload's REST and GraphQL collection endpoints cannot be reached here.
  #     Access control holds up on them — an anonymous reader sees published,
  #     public documents and nothing else — but `?limit=0` disables pagination
  #     (Payload treats it as "no limit"), so one short request returns every
  #     post in the database with its full body. The website never calls them
  #     from the browser: pages render through Payload's Local API on the
  #     server, and the only fetch the frontend makes is to /search/suggest.
  #
  # The two exceptions are what the public pages genuinely need: the *files*
  # under `/api/media/file/` are every uploaded image, and `/api/preview` is how
  # an editor's draft session reaches the frontend.
  #
  # `/oauth*` and `/.well-known/oauth-*` join them for the same reason as the
  # admin panel. Both hostnames resolve to the same VPS and serve the same
  # application, so without this the authorization server would answer on the
  # address readers use — a consent screen and a token endpoint on the public
  # site, and a discovery document advertising them. The issuer is the CMS
  # origin (`lib/oauth/config.ts` derives it from CMS_ADDRESS, never from the
  # request's Host), so nothing legitimate ever asks for these here.
  #
  # `/api/media/file/*` and not `/api/media*`, because those are different
  # things. The first is the uploads themselves. The second also includes the
  # collection endpoint, which is `read: publicRead` — so the exception as
  # originally written left `GET /api/media?limit=0` answerable by anyone, and
  # that is the same unpaginated full-table read the paragraph above refuses for
  # posts. Nothing on a page ever asks for the collection; only for files.
  #
  # Written as one matcher with an explicit `not` rather than as overlapping
  # `handle` blocks, so what is served here does not depend on how Caddy sorts
  # matchers by specificity — the rule reads the same way it evaluates.
  # `/redirects-map` joins them: it exists only so the edge middleware can read
  # the redirect table, which it does by connecting to the app's own loopback
  # address rather than through this proxy, so refusing it here costs the site
  # nothing and stops an anonymous caller reading the migration's URL map.
  # `/ads.txt` is answered here rather than by the application.
  #
  # Neither route through the app works today, and the second fails quietly:
  # `output: 'standalone'` skips `public/`, and the file lives at the
  # repository root anyway, which was never a URL Next would answer; and
  # `middleware.ts` excludes any path containing a dot, so a redirect row for
  # this path can sit in Payload looking perfectly configured and never run.
  # `pnpm validate:redirects` reports both as errors, which is how this was
  # found rather than discovered on cutover day.
  #
  # Serving it at the edge also keeps it clear of `trailingSlash: true`, which
  # puts every Next route at its slashed form while an ads.txt crawler asks for
  # `/ads.txt` exactly. Answering before the proxy means that question never
  # has to be settled.
  #
  # An unreadable ads.txt is not a degraded one: buyers treat it as absent,
  # which makes the inventory unauthorised. See docs/ADVERTISING.md §1.
  #
  # The file is bind-mounted from the repository root (docker-compose.yml), so
  # the committed file is the one served and there is no second copy to drift
  # out of step with it.
  handle /ads.txt {
    root * /srv
    file_server
  }

  # Ghost's four child sitemaps, sent to the one this site publishes.
  #
  # Ghost split its sitemap into `/sitemap-posts.xml`, `-pages`, `-tags` and
  # `-authors`, with `/sitemap.xml` as an index over them. This site publishes a
  # single flat `/sitemap.xml` instead, so the four children have nothing behind
  # them and 404 — confirmed on staging, where each returned Next's HTML error
  # page rather than XML.
  #
  # They cannot be redirected in the application, for the same reason `/ads.txt`
  # cannot be served by it: `middleware.ts` excludes any path containing a dot,
  # so a redirect row for one of these imports cleanly, shows as enabled, and
  # never fires. `docs/SEO_AND_REDIRECTS.md` names this class explicitly.
  #
  # It matters because Google holds these URLs independently of the pages they
  # list — from Ghost's sitemap index and from Search Console — and keeps asking
  # for them after the pages have moved. A 404 there is a reported sitemap
  # failure rather than a lost page, which is why this is a 301 to the live
  # sitemap rather than a 410: the answer to "where is the sitemap" is not
  # "nowhere", it is "over here".
  #
  # Answering at the edge also keeps these clear of `trailingSlash: true`, which
  # would otherwise put a dotted path's redirect target at its slashed form.
  # Written as a site-level `redir` with a named matcher, not as a `redir`
  # inside a `handle`. `redir` takes an optional matcher as its *first*
  # argument — `redir [<matcher>] <to> [<code>]` — so `redir /sitemap.xml 301`
  # inside a handle block does not mean what it looks like: Caddy reads
  # `/sitemap.xml` as the matcher and `301` as the destination, and defaults
  # the status to 302. Adapting that form produces
  # `status: 302, Location: "301"` on a route that can never match, and the
  # handle block, left with nothing to do, answers 200 with an empty body.
  # That shipped once and had to be caught by probing the live host.
  #
  # A named matcher cannot be confused for a destination, so this form says
  # what it does. `redir` also sorts ahead of `handle` in Caddy's directive
  # order, which keeps it clear of the catch-all proxy below.
  @ghostSitemaps path /sitemap-posts.xml /sitemap-pages.xml /sitemap-tags.xml /sitemap-authors.xml
  redir @ghostSitemaps /sitemap.xml 301

  @staffOnly {
    path /api* /admin* /redirects-map* /oauth* /.well-known/oauth-*
    not path /api/media/file/* /api/preview*
  }

  handle @staffOnly {
    respond "Not found" 404
  }

  handle {
    reverse_proxy app:3000
  }
}

# The same site under its other name, sent to the canonical one.
#
# `www.beyondeveryart.com` and `beyondeveryart.com` are separate hosts to a
# browser, a certificate authority, and a search engine. Ghost answers on both
# and treats the `www` form as canonical, so that is the host every indexed URL
# and every inbound link uses, and the host this deployment has to keep serving.
# The other one still has to answer — people type it, and old links use it — but
# it must not serve the site, because two hosts serving identical pages is a
# duplicate of every URL the site has.
#
# 301 rather than 302: this is permanent, and only a permanent redirect passes
# the accumulated ranking signal on to the destination. `{uri}` carries the path
# and query through, so a deep link keeps working rather than landing on the
# homepage.
#
# Set SITE_REDIRECT_FROM to the non-canonical host. Leaving it unset disables
# the block, which is what a local or staging deployment wants: Caddy would
# otherwise try, and fail, to get a certificate for a name that does not exist.
{$SITE_REDIRECT_FROM:redirect-disabled.localhost} {
  import {$CADDY_ACME:acme-default}

  redir https://{$SITE_ADDRESS:localhost}{uri} permanent
}

# CMS and staff tooling: Payload Admin and the MCP endpoint.
#
# A separate hostname so the VPS can hold a real certificate — and a working
# MCP endpoint — while the apex domain still points at the live Ghost site.
# Point a DNS A record for this name at the VPS and set CMS_ADDRESS; until you
# do, Caddy fails to issue a certificate for it and logs so, which is expected
# and does not affect the site above.
#
# Mobile connectors reach this from Anthropic's or OpenAI's servers, not from
# the phone, so it cannot be restricted by source IP, client certificate, or a
# tunnel: the bearer key is the credential. What stands behind it — keys scoped
# per key in the admin panel, acting as a real Payload user under normal access
# control, unable to publish unless that user is an administrator, and rate
# limited in the application because Caddy's standard build has none.
#
# This hostname used to proxy everything unconditionally, which quietly undid
# the block above: both names resolve to the same VPS and serve the same
# application, so `GET /api/posts?limit=0` was refused on the site's address and
# answered on this one. A rule that only holds on one of two public hostnames is
# not a rule. So the collection API is closed here too, for requests that carry
# no credential at all.
#
# Credential-presence, not authentication — and weaker than it reads, which is
# worth stating here rather than leaving for somebody to assume. Both matchers
# test for a *header*, not for a valid one: `Authorization: anything` and a
# `payload-token=` cookie of any value both satisfy them, and neither is hard
# to send. So this stops a plain `curl` and an untargeted crawler, and it does
# not stop anyone who reads this file.
#
# What still holds behind it is the part that matters: Payload's own access
# control. `postsRead` in access/roles.ts answers an anonymous or unauthenticated
# caller with published, public documents only, so a forged header buys the same
# listing the website already renders — not drafts, not members-only bodies, not
# members, billing, or users.
#
# What does *not* hold is the second thing this block was written for. The
# unpaginated read and the request volume it describes reach Postgres before
# access control is consulted, so a one-header change puts them back. Closing
# that needs either a check of the credential itself at the edge, or the WAF in
# docs/EDGE_PROTECTION.md; it is not something this matcher can do.
#
# Written inside `route` so these evaluate top to bottom as written. `handle`
# blocks are otherwise sorted by matcher specificity, and the order is the whole
# meaning here.
{$CMS_ADDRESS:cms.localhost} {
  import {$CADDY_ACME:acme-default}

  encode zstd gzip

  route {
    # Endpoints that have to answer without a credential, because they are how
    # one is obtained or used: the MCP endpoint carries its own bearer key and
    # is rate limited per key and per source in the application; the auth routes
    # are the login form, the session check the admin makes before it knows
    # whether anyone is signed in, and password reset; `/api/access` is what the
    # admin asks to find out what it may render. Media files and preview match
    # the public site's own exceptions.
    @openApi path /api/mcp* /api/users/* /api/access* /api/media/file/* /api/preview*
    handle @openApi {
      reverse_proxy app:3000
    }

    # An admin session. The cookie is httpOnly and set by Payload on this
    # hostname, so the browser attaches it to every admin request without the
    # panel doing anything.
    @sessionApi {
      path /api*
      header Cookie *payload-token=*
    }
    handle @sessionApi {
      reverse_proxy app:3000
    }

    # A bearer or JWT credential, which is how a non-browser client
    # authenticates against Payload.
    @tokenApi {
      path /api*
      header Authorization *
    }
    handle @tokenApi {
      reverse_proxy app:3000
    }

    # Anything else under /api is an anonymous request for collection data.
    handle /api* {
      respond "Not found" 404
    }

    # The admin panel itself, and everything else this hostname serves.
    handle {
      reverse_proxy app:3000
    }
  }
}
