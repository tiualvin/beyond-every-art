# Public site.
{$SITE_ADDRESS:localhost} {
  encode zstd gzip

  # Staff tooling is served only on the CMS hostname below, so the address
  # readers and search engines use exposes no write endpoint and no login form
  # at all. Two things follow from that:
  #
  #   - The admin panel cannot be reached here. Payload locks an account after
  #     five failed passwords, which stops guessing but means anyone who can
  #     find the login form can also lock an editor out of it on demand.
  #   - Payload's REST and GraphQL collection endpoints cannot be reached here.
  #     Access control holds up on them — an anonymous reader sees published,
  #     public documents and nothing else — but `?limit=0` disables pagination
  #     (Payload treats it as "no limit"), so one short request returns every
  #     post in the database with its full body. The website never calls them
  #     from the browser: pages render through Payload's Local API on the
  #     server, and the only fetch the frontend makes is to /search/suggest.
  #
  # The two exceptions are what the public pages genuinely need: `/api/media`
  # serves every uploaded image, and `/api/preview` is how an editor's draft
  # session reaches the frontend.
  #
  # Written as one matcher with an explicit `not` rather than as overlapping
  # `handle` blocks, so what is served here does not depend on how Caddy sorts
  # matchers by specificity — the rule reads the same way it evaluates.
  @staffOnly {
    path /api* /admin*
    not path /api/media* /api/preview*
  }

  handle @staffOnly {
    respond "Not found" 404
  }

  handle {
    reverse_proxy app:3000
  }
}

# CMS and staff tooling: Payload Admin and the MCP endpoint.
#
# A separate hostname so the VPS can hold a real certificate — and a working
# MCP endpoint — while the apex domain still points at the live Ghost site.
# Point a DNS A record for this name at the VPS and set CMS_ADDRESS; until you
# do, Caddy fails to issue a certificate for it and logs so, which is expected
# and does not affect the site above.
#
# Mobile connectors reach this from Anthropic's or OpenAI's servers, not from
# the phone, so it cannot be restricted by source IP, client certificate, or a
# tunnel: the bearer key is the credential. What stands behind it — keys scoped
# per key in the admin panel, acting as a real Payload user under normal access
# control, unable to publish unless that user is an administrator, and rate
# limited in the application because Caddy's standard build has none.
{$CMS_ADDRESS:cms.localhost} {
  encode zstd gzip
  reverse_proxy app:3000
}
