{
  "name": "beyond-every-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "pnpm migrate:db && pnpm seed:dev && pnpm seed:e2e && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot": "tsx scripts/screenshot.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "migrate:db": "node scripts/run-migrations.mjs",
    "migrate:db:create": "payload migrate:create",
    "migrate:db:status": "payload migrate:status",
    "migrate:db:down": "payload migrate:down",
    "migrate:db:baseline": "tsx scripts/baseline-migrations.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:e2e": "tsx e2e/seed.ts",
    "inventory:ghost": "tsx scripts/inventory-ghost-cards.ts",
    "migrate:ghost": "tsx scripts/migrate-ghost.ts",
    "migrate:redirects": "tsx scripts/migrate-redirects.ts",
    "migrate:members": "tsx scripts/migrate-members.ts",
    "migrate:validate": "tsx scripts/validate-migration.ts",
    "backfill:media": "tsx scripts/backfill-media-sizes.ts",
    "restore:media": "tsx scripts/restore-media-from-ghost.ts",
    "migration:compare": "tsx scripts/compare-sites.ts",
    "validate:redirects": "tsx scripts/validate-redirects.ts",
    "reconcile:billing": "tsx scripts/reconcile-billing.ts",
    "backup:db": "tsx scripts/backup-database.ts",
    "restore:db": "tsx scripts/restore-database.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "framer-motion": "^13.1.1",
    "graphql": "16.14.2",
    "next": "15.5.23",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.13",
      "fast-uri": "^3.1.5",
      "hono": "^4.12.34",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "sharp": "^0.35.3",
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  }
}
