node_modules/
# pnpm's content-addressable store, created by running pnpm outside a container.
# Cache, not source, and it grows without bound.
.pnpm-store/
.next/
dist/
coverage/
playwright-report/
test-results/
# Ad hoc QA captures from `pnpm screenshot` — see docs/SCREENSHOTS.md.
/screenshots/
# Local media uploads. Production stores media in Cloudflare R2; without the
# S3_* variables Payload falls back to writing files here.
/media/
*.tsbuildinfo
.env
.env.*
!.env.example
*.log
.DS_Store

# Local Claude metadata and linked worktree checkouts are not project source.
/.claude/

# Private Ghost migration material must never be committed.
#
# Two directory names, because the rule is about the material and not about
# where someone put it: `ghost-export/` is what the runbooks tell you to use,
# and `ghost-archive/` is what the production VPS actually has. The second was
# untracked but unignored for weeks — a weaker guarantee than it looks, since
# untracked means one `git add -A` away from committed. The extension rules
# below caught the DB dump and the content JSON by luck; the ~1,374 media
# files, `redirects.json` and `routes.yaml` were covered by nothing.
ghost-export/
ghost-archive/
ghost-content*.json
ghost-members*.csv
complete-site-archive*.zip
*.dump
*.sql
# ...but schema migrations are source, and `*.sql` above was hiding them. The
# database ones Payload generates today are `.ts` plus a `.json` snapshot, so
# nothing has been lost yet; a hand-written SQL migration would have been
# silently uncommitted, and CI's drift check — which looks for new files under
# `migrations/` — would have reported everything was fine.
!migrations/*.sql
migration-report*.json
/.migration-reports/
validation-report*.json
members-report*.json
reconciliation-report*.json
media-backfill-report*.json
media-restore-report*.json

# Search Console and GA4 exports. This repository is public, so committing them
# would publish the site's query data and traffic figures; the README explaining
# what belongs here is kept, the data is not. Same reasoning as the Ghost block
# above — see docs/SEO_BASELINE_CAPTURE.md for where the files should live
# instead.
seo-baseline/*
!seo-baseline/README.md

# Payload generated types (run `pnpm generate:types`)
payload-types.ts

# Payload rewrites the admin import map on every dev boot. The tracked
# `importMap.ts` is what the admin page imports; this generated sibling is not.
app/(payload)/admin/importMap.js
