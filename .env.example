DATABASE_URI=postgresql://payload:payload@localhost:5432/beyond_every_art
PAYLOAD_SECRET=replace-with-a-long-random-development-secret
# Draft preview needs no secret. The admin "Preview" button and the Live Preview
# iframe both authenticate with the logged-in Payload session, and draft
# rendering re-checks it, so there is no shared value to configure or rotate.
# One-time administrator bootstrap. Leave unset except while running
# `pnpm bootstrap:admin`, then remove the values from your environment.
PAYLOAD_BOOTSTRAP_EMAIL=
PAYLOAD_BOOTSTRAP_NAME=
PAYLOAD_BOOTSTRAP_PASSWORD=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Must be the origin the Payload admin is served from. Live Preview embeds this
# origin in an iframe and only trusts save messages coming from it, and the
# draft-mode cookie is only sent back if the two origins match.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3 compatible). Leave unset to use local media storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Database backups (pnpm backup:db / restore:db and the backup container).
# Backups reuse the S3_* credentials above. Set BACKUP_S3_BUCKET only to send
# backups to a bucket separate from media; otherwise S3_BUCKET is used.
BACKUP_S3_BUCKET=
BACKUP_PREFIX=db-backups
BACKUP_RETENTION_COUNT=14
# Passphrase for encrypting backups at rest (AES-256-GCM). Leave unset and
# backups upload as plain gzip, which means the whole member archive is
# readable by anyone holding the storage credential — the backup run says so on
# every run. Generate one with `openssl rand -base64 32`.
#
# Keep a copy somewhere other than this server and the backup bucket. Lose it
# and every encrypted backup is unrecoverable; rotating it leaves older backups
# readable only with the previous value, so keep the old one until they age out
# of the retention window.
BACKUP_ENCRYPTION_KEY=
# Container-only: cron schedule and whether to run one backup on startup.
BACKUP_CRON=0 3 * * *
BACKUP_ON_START=false

# Container-only: the daily Stripe reconciliation sweep, an hour after the
# backup by default. It stays inert, and says so in its log, until
# STRIPE_SECRET_KEY below is set — the cutover runbook requires it to be running
# before Ghost's Stripe connection is removed, because nothing else notices a
# renewal or a cancellation once Ghost is gone.
RECONCILE_CRON=0 4 * * *
RECONCILE_ON_START=false

# Postgres and reverse-proxy settings used by docker-compose in production.
POSTGRES_DB=beyond_every_art
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
# Per-container memory ceilings. The defaults in docker-compose.yml are
# deliberately generous so they cannot cause the outage they exist to prevent;
# tighten them to the real VPS. A limit caps a container, it never reserves
# memory, so these may total more than the machine has.
APP_MEMORY_LIMIT=2g
POSTGRES_MEMORY_LIMIT=1g
CADDY_MEMORY_LIMIT=256m
BACKUP_MEMORY_LIMIT=512m
RECONCILE_MEMORY_LIMIT=1g
# Container log rotation. Docker keeps json-file logs forever by default, which
# on a fixed disk is a slow outage. These cap each service at max-size x
# max-file — 30MB per service with the defaults below.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
# Set to 1 only once Cloudflare is actually proxying traffic (the orange cloud),
# so rate limiting keys on CF-Connecting-IP — the real visitor — rather than on
# Cloudflare's edge address. While the proxy is off that header is forgeable by
# anyone, which is why this is opt-in. See docs/EDGE_PROTECTION.md.
TRUST_CLOUDFLARE_IP=
# Rate limits for the public endpoints, per source address. Blank uses the
# defaults in the code, which are the intended policy; raise them only with a
# reason. Signups are per hour, searches per minute.
RATE_LIMIT_SIGNUP_PER_HOUR=
RATE_LIMIT_SEARCH_PER_MINUTE=
RATE_LIMIT_SEARCH_SUGGEST_PER_MINUTE=
# The two endpoints that answer anyone without a credential: /health, which
# reaches the database on every call, and /csp-report, which writes a log line.
RATE_LIMIT_HEALTH_PER_MINUTE=
RATE_LIMIT_CSP_REPORT_PER_MINUTE=
# The MCP endpoint is limited per key rather than per address, because the
# requests arrive from a vendor's cloud and share source addresses. Key
# *guessing* is bounded separately and by address, since the caller chooses what
# key it presents: RATE_LIMIT_MCP_AUTH_FAILURES is failed authentications per
# source per fifteen minutes.
RATE_LIMIT_MCP_PER_MINUTE=
RATE_LIMIT_MCP_AUTH_FAILURES=
# Logins per source address per fifteen minutes. Payload locks an account after
# five failed passwords, which stops guessing; this bounds how many bcrypt
# comparisons one address can buy. Blank uses 20.
RATE_LIMIT_LOGIN_PER_15M=
# Largest file the admin panel will store, in megabytes. Blank uses 25, which is
# generous enough for a high-resolution photograph of a work. Uploads over MCP
# have their own, lower ceiling in code. This bounds what gets stored, not what
# a stranger can make the server receive — see docs/EDGE_PROTECTION.md.
MEDIA_MAX_UPLOAD_MB=
# Domain Caddy serves and provisions HTTPS for, e.g. beyondeveryart.com.
SITE_ADDRESS=localhost
# Staff hostname for Payload Admin and the MCP endpoint, e.g.
# cms.beyondeveryart.com. Kept separate from SITE_ADDRESS so the VPS can hold a
# real certificate while the apex domain still points at the live Ghost site.
#
# Payload is also told about this hostname: together with the site URL above it
# forms the `csrf` allowlist, which is what lets Payload accept a session cookie
# only from origins this deployment actually serves, and what lets it trust the
# `Host` header enough to put a working link in a password-reset email. Set it
# even where Caddy is not the proxy. PAYLOAD_PUBLIC_CMS_URL overrides the
# derived origin when the admin is fronted some other way.
CMS_ADDRESS=cms.localhost
PAYLOAD_PUBLIC_CMS_URL=

# Where the container can reach itself, for the edge middleware's fetch of
# /redirects-map. Defaults to http://127.0.0.1:$PORT, which is right unless the
# app listens somewhere unusual. Never a public URL: this request must not
# leave the container or pass through the proxy.
INTERNAL_ORIGIN=

# Transactional email via Resend. Set the key and from-address to enable admin
# password reset / verification email; leave the key unset to disable email.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Beyond Every Art

# Stripe (website subscriptions). STRIPE_WEBHOOK_SECRET is the signing secret
# of the endpoint you create for POST /webhooks/stripe; without it the endpoint
# refuses every request. STRIPE_SECRET_KEY lets the webhook read a subscription
# back from Stripe instead of trusting the payload, and is required by
# `pnpm reconcile:billing`. Use separate sandbox and production values; never
# commit either. STRIPE_API_VERSION pins the API version (blank = account
# default) and STRIPE_API_BASE only exists to point tests at a stub.
# Checkout for the paid membership shown in the subscribe modal. This app has
# no checkout of its own — lib/billing reads Stripe webhooks and reconciles
# subscription state, but nothing here creates a session — so paste a Stripe
# Payment Link per billing period. Leave blank and the modal says paid
# membership is not open yet rather than offering a button that fails.
#
# These two are read at BUILD time, not at run time. `checkoutUrl()` runs inside
# a client component, so Next.js substitutes the values into the browser bundle
# during `pnpm build` — setting them here and restarting the container is not
# enough, the image has to be rebuilt. docker-compose.yml passes them to the
# build as arguments from this same file, so `docker compose up -d --build`
# picks up a change; `docker compose up -d` on its own will not.
NEXT_PUBLIC_CHECKOUT_URL_MONTHLY=
NEXT_PUBLIC_CHECKOUT_URL_YEARLY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_API_BASE=

# Google Analytics 4 measurement ID. Loaded only when set and not noindexed.
NEXT_PUBLIC_GA_ID=

# MCP server for Claude and Codex (docs/MCP_SERVER.md). Unset means the
# endpoint is not mounted at all; MCP_ENABLED=1 serves POST /api/mcp. The API
# keys themselves are created in Payload Admin under MCP → API Keys, never
# here: they are per person, must not be committed, and are encrypted with
# PAYLOAD_SECRET, so rotating that secret invalidates every one of them.
#
# Note that /api is outside the middleware matcher, so STAGING_BASIC_AUTH does
# not cover this endpoint, and it cannot be restricted by source IP, client
# certificate, or a tunnel either: mobile connectors are dialled by Anthropic's
# or OpenAI's servers, not by the phone. The bearer key is the credential. What
# stands behind it is in the Caddyfile and docs/MCP_SERVER.md — served only on
# CMS_ADDRESS, rate limited per key and per source address, scoped per key in
# the admin panel, and unable to publish unless its user is an administrator.
MCP_ENABLED=

# OAuth for MCP connectors (docs/MCP_OAUTH.md). Unset, the endpoint takes only
# the bearer API keys above and the /oauth/* routes do not exist. Set to 1 to
# mount the authorization server, which is what lets the claude.ai and ChatGPT
# connector dialogs — neither of which can send a fixed Authorization header on
# every account — connect at all.
#
# It adds three publicly reachable endpoints: registration (unauthenticated by
# design, RFC 7591), the consent screen (requires a Payload admin session), and
# the token endpoint. All three are rate limited per source address, and the
# limits below override the defaults if the built-in ones prove wrong.
#
# Tokens are minted against PAYLOAD_SECRET, so rotating it revokes every
# connector as well as every API key. A grant also expires ninety days after it
# was approved however often it refreshes, so a connector has to be reconnected
# then — an unattended one stops until somebody does.
MCP_OAUTH_ENABLED=
RATE_LIMIT_OAUTH_REGISTER_PER_HOUR=
RATE_LIMIT_OAUTH_TOKEN_PER_MINUTE=

# Where to post an alert when something needs a person's attention. Unset — the
# default — means no alert is ever sent and no outbound request is ever made.
#
# Today exactly one thing uses it: a run of MCP authentications presenting keys
# this deployment does not recognise, which on a public write endpoint whose only
# credential is a bearer token is the thing most worth knowing about. Ten
# failures from one address inside five minutes fires once, then stays quiet for
# fifteen minutes.
#
# A Slack or Discord incoming webhook URL works as-is; the body carries a `text`
# field those render. No credential is ever included.
ALERT_WEBHOOK_URL=

# Staging protection. NEXT_PUBLIC_NOINDEX=1 makes robots.txt disallow all and
# adds a noindex meta tag. STAGING_BASIC_AUTH=user:password gates the whole site
# behind HTTP Basic Auth. Leave both unset in production.
NEXT_PUBLIC_NOINDEX=
STAGING_BASIC_AUTH=

# Content-Security-Policy. Unset behaves as report-only: the browser reports
# what it would have blocked and blocks nothing. Set CSP_MODE=enforce only after
# working through docs/CONTENT_SECURITY_POLICY.md; CSP_MODE=off is an incident
# escape hatch, not a steady state.
CSP_MODE=
# Space- or comma-separated origins allowed to be framed, for provider embeds
# inside migrated Ghost bodies (for example https://www.youtube-nocookie.com).
# Fill this from the report-only findings rather than from guesswork.
CSP_FRAME_SRC=
# External collector for violation reports. Defaults to the built-in
# /csp-report endpoint, which logs one JSON line per violation.
CSP_REPORT_URI=

# Paths only. Never commit the files referenced by these variables.
GHOST_EXPORT_PATH=./ghost-export/ghost-content.json
# Origin that __GHOST_URL__ placeholders in the export resolve against, for
# `pnpm migrate:ghost`. The --ghost-base-url flag overrides it.
GHOST_SITE_URL=

# Browser tests. PLAYWRIGHT_BASE_URL points the suite at an already-running
# server instead of the one it starts. Seeding refuses to run against a
# non-local database unless E2E_ALLOW_REMOTE_SEED=1, so a stray environment
# variable cannot let a test suite overwrite production content.
PLAYWRIGHT_BASE_URL=
E2E_ALLOW_REMOTE_SEED=
