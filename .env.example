DATABASE_URI=postgresql://payload:payload@localhost:5432/beyond_every_art
PAYLOAD_SECRET=replace-with-a-long-random-development-secret
# Optional fallback secret for /api/preview. The admin "Preview" button and the
# Live Preview iframe authenticate with the logged-in Payload session instead,
# so this can stay unset; set it only to build preview links outside the admin.
PAYLOAD_PREVIEW_SECRET=
# One-time administrator bootstrap. Leave unset except while running
# `pnpm bootstrap:admin`, then remove the values from your environment.
PAYLOAD_BOOTSTRAP_EMAIL=
PAYLOAD_BOOTSTRAP_NAME=
PAYLOAD_BOOTSTRAP_PASSWORD=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# Must be the origin the Payload admin is served from. Live Preview embeds this
# origin in an iframe and only trusts save messages coming from it, and the
# draft-mode cookie is only sent back if the two origins match.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3 compatible). Leave unset to use local media storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Database backups (pnpm backup:db / restore:db and the backup container).
# Backups reuse the S3_* credentials above. Set BACKUP_S3_BUCKET only to send
# backups to a bucket separate from media; otherwise S3_BUCKET is used.
BACKUP_S3_BUCKET=
BACKUP_PREFIX=db-backups
BACKUP_RETENTION_COUNT=14
# Container-only: cron schedule and whether to run one backup on startup.
BACKUP_CRON=0 3 * * *
BACKUP_ON_START=false

# Postgres and reverse-proxy settings used by docker-compose in production.
POSTGRES_DB=beyond_every_art
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
# Domain Caddy serves and provisions HTTPS for, e.g. beyondeveryart.com.
SITE_ADDRESS=localhost

# Transactional email via Resend. Set the key and from-address to enable admin
# password reset / verification email; leave the key unset to disable email.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Beyond Every Art

# Stripe (website subscriptions). STRIPE_WEBHOOK_SECRET is the signing secret
# of the endpoint you create for POST /webhooks/stripe; without it the endpoint
# refuses every request. STRIPE_SECRET_KEY lets the webhook read a subscription
# back from Stripe instead of trusting the payload, and is required by
# `pnpm reconcile:billing`. Use separate sandbox and production values; never
# commit either. STRIPE_API_VERSION pins the API version (blank = account
# default) and STRIPE_API_BASE only exists to point tests at a stub.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_API_BASE=

# Google Analytics 4 measurement ID. Loaded only when set and not noindexed.
NEXT_PUBLIC_GA_ID=

# Staging protection. NEXT_PUBLIC_NOINDEX=1 makes robots.txt disallow all and
# adds a noindex meta tag. STAGING_BASIC_AUTH=user:password gates the whole site
# behind HTTP Basic Auth. Leave both unset in production.
NEXT_PUBLIC_NOINDEX=
STAGING_BASIC_AUTH=

# Paths only. Never commit the files referenced by these variables.
GHOST_EXPORT_PATH=./ghost-export/ghost-content.json
GHOST_MEDIA_PATH=./ghost-export/content/images
